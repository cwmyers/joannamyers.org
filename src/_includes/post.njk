---
layout: base.njk
---
<article class="post">
	<header class="post-header">
		<h1>{{ title }}</h1>
		<p class="post-meta">
			<time datetime="{{ date | iso }}">{{ date | dateFmt }}</time>
			&middot; {{ content | readingTime }} min read
			{% if tags and tags.length > 1 %}
			&middot;
			{%- for t in tags %}{% if t != "posts" %} <span class="tag">{{ t }}</span>{% endif %}{% endfor %}
			{% endif %}
		</p>
	</header>

	<div class="post-body prose">
		{{ content | safe }}
	</div>

	<nav class="post-nav">
		{% set prev = collections.posts | newestFirst | previousItem(page) %}
		{% set next = collections.posts | newestFirst | nextItem(page) %}
		{% if prev %}<a class="prev" href="{{ prev.url | url }}">&larr; {{ prev.data.title }}</a>{% endif %}
		{% if next %}<a class="next" href="{{ next.url | url }}">{{ next.data.title }} &rarr;</a>{% endif %}
	</nav>
</article>
