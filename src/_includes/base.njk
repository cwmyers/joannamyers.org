<!DOCTYPE html>
<html lang="en-GB">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>{% if title %}{{ title }} — {% endif %}{{ site.name }}</title>
	<meta name="description" content="{{ description or site.description }}">
	<meta name="generator" content="Eleventy">
	<link rel="canonical" href="{{ site.url }}{{ page.url }}">
	<link rel="alternate" type="application/rss+xml" title="{{ site.name }}" href="{{ "/feed.xml" | url }}">
	<link rel="icon" type="image/svg+xml" href="{{ "/favicon.svg" | url }}">

	<!-- Google tag (gtag.js) -->
	<script async src="https://www.googletagmanager.com/gtag/js?id=G-CG83VJCL75"></script>
	<script>
		window.dataLayer = window.dataLayer || [];
		function gtag(){dataLayer.push(arguments);}
		gtag('js', new Date());
		gtag('config', 'G-CG83VJCL75');
	</script>

	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,700;1,500&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&family=Damion&display=swap" rel="stylesheet">
	<link rel="stylesheet" href="{{ "/css/style.css" | url }}">
</head>
<body>
	<a class="skip-link" href="#main">Skip to content</a>

	<header class="site-header">
		<div class="wrap">
			<a class="site-title" href="{{ "/" | url }}">{{ site.name }}</a>
			<p class="site-tagline">Faith · Family · Life in all its colours</p>
			<nav class="site-nav" aria-label="Main">
				<a {% if page.url == "/" %}aria-current="page"{% endif %} href="{{ "/" | url }}">Home</a>
				<a {% if page.url.startsWith("/archive") %}aria-current="page"{% endif %} href="{{ "/archive/" | url }}">Archive</a>
				<a {% if page.url == "/about/" %}aria-current="page"{% endif %} href="{{ "/about/" | url }}">About</a>
			</nav>
		</div>
	</header>

	<main id="main" class="wrap">
		{{ content | safe }}
	</main>

	<footer class="site-footer">
		<div class="wrap">
			<p>© {% year %} {{ site.author }} · <a href="{{ "/feed.xml" | url }}">RSS</a></p>
		</div>
	</footer>
</body>
</html>
