---
layout: base.njk
title: Archive
permalink: /archive/
---

<h1 class="page-title">Archive</h1>
<p class="page-sub">Every post, newest first.</p>

{% set years = collections.posts | newestFirst | groupByYear %}
{% for year in years %}
<section class="archive-year">
	<h2>{{ year.year }}</h2>
	<ul class="archive-list">
		{% for post in year.posts %}
		<li>
			<time datetime="{{ post.date | iso }}">{{ post.date | dateFmt }}</time>
			<a href="{{ post.url | url }}">{{ post.data.title }}</a>
		</li>
		{% endfor %}
	</ul>
</section>
{% endfor %}
